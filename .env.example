# Pristmax Environment Configuration
# 复制此文件为 .env 并修改相应值

# 数据库路径
PRISTMAX_DB=/opt/pristmax/tasks.db
AUTH_DB=/opt/pristmax/auth.db

# Flask 配置
FLASK_ENV=production
FLASK_DEBUG=0

# 服务配置
PORT=5001
HOST=0.0.0.0

# 安全密钥（至少32字符）
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# 可选: SMTP 邮件配置（用于通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=pristmax@example.com

# 可选: S3/OSS 配置（用于云存储）
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_BUCKET=your-bucket
